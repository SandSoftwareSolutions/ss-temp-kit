{
  "name": "@sandsoftwaresolutions/temp-kit",
  "version": "0.1.2",
  "description": "Temporary folders and files that clean up after themselves, also on failure and at exit. Names cannot escape the folder.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "temp",
    "tmp",
    "testing",
    "cleanup"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-temp-kit.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-temp-kit/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-temp-kit#readme",
  "publishConfig": {
    "access": "public"
  }
}
