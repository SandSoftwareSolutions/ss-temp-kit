{
  "name": "@sandsoftwaresolutions/temp-kit",
  "version": "0.1.0",
  "description": "Temporary folders and files that clean up after themselves, also on failure and at exit. Names cannot escape the folder.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "temp",
    "tmp",
    "testing",
    "cleanup"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-temp-kit.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-temp-kit/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-temp-kit#readme",
  "publishConfig": {
    "access": "public"
  }
}
